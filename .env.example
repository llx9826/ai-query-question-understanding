# 对外端口。管理页面与业务 API 共用 30001；Wren 仅绑定宿主机回环地址的 30002。
AIQ_PUBLIC_PORT=30001
WREN_HTTP_PUBLIC_PORT=30002

# 镜像与源码版本。两个仓库相邻时直接使用本地 WrenAI，不再从 GitHub 下载。
AIQ_IMAGE_TAG=0.1.1
WREN_HTTP_IMAGE_TAG=0.1.1
WREN_HTTP_BUILD_CONTEXT=../WrenAI

# 部署前生成三个不同的随机值，每个至少 32 个字符；不要提交真实值。
DEPLOY_USER_API_TOKEN=replace-with-random-user-token
DEPLOY_WREN_ADMIN_TOKEN=replace-with-random-admin-token
DEPLOY_WREN_WORKSPACE_TOKEN=replace-with-random-workspace-token

# 百炼仅由 Wren HTTP 使用。
BAILIAN_API_KEY=replace-with-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL_NAME=qwen3.7-plus

# 业务和运行参数。
AIQ_WORKSPACE_ID=conference-2026
AIQ_DATASET_MAX_UPLOAD_BYTES=52428800
AIQ_WREN_HTTP_TIMEOUT_SECONDS=90
WREN_MODEL_TIMEOUT_SECONDS=60
WREN_MODEL_REQUEST_LIMIT=12
WREN_MEMORY_ENABLED=true

# 如果服务器只克隆了问数平台，可改用远程固定版本：
# WREN_HTTP_BUILD_CONTEXT=https://github.com/llx9826/WrenAI.git#wren-http-v0.1.1
